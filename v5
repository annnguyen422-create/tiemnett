<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#FFB84D">
<title>Tiệm Net</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;800;900&display=swap" rel="stylesheet">
<style>
:root{--pri:#FFB84D;--sec:#FF7A59;--acc:#5CC8A1;--bg:#FFF7EA;--dark:#303030;--ok:#58B368;--warn:#F2B84B;--bad:#E85D5D;--blue:#5B9DEF;--muted:#7a6f63;--line:#efdcc0}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:var(--bg);color:var(--dark);font-family:Nunito,system-ui,sans-serif;font-weight:600;overflow:hidden;user-select:none;-webkit-user-select:none}
button{font:inherit;color:inherit;cursor:pointer;border:2px solid var(--dark);background:#fff;border-radius:12px;min-height:44px;padding:4px 12px;line-height:1.2}
button:active{transform:scale(.96)}
button:focus-visible,[data-act]:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
button.pri{background:var(--pri)} button.ok{background:var(--acc)} button.danger{background:#FDE5E5} button.go{background:var(--ok);color:#fff}
button.sm{min-height:36px;font-size:13px;padding:2px 8px;border-radius:10px}
#app{display:flex;flex-direction:column;height:100%}
/* ---- thanh trên: luôn 1 hàng ---- */
#top{display:flex;flex-wrap:nowrap;gap:5px;align-items:center;padding:6px 8px;background:#fff;border-bottom:2px solid var(--dark);overflow:hidden}
.chip{padding:4px 8px;border-radius:999px;background:var(--bg);border:2px solid var(--dark);font-size:13px;white-space:nowrap;flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}
#bStatus{flex:none;min-height:32px;padding:2px 10px;border-radius:999px;font-weight:900;font-size:12px;white-space:nowrap}
#bStatus.prep{background:var(--pri);animation:pulse 1s infinite alternate}
#bStatus.open{background:var(--ok);color:#fff} #bStatus.closing{background:var(--warn)} #bStatus.report{background:#eee}
@keyframes pulse{to{transform:scale(1.06)}}
#bPause{margin-left:auto;flex:none;min-height:36px;min-width:42px;padding:0 6px;font-size:15px;border-radius:10px}
#bPause.on{background:var(--dark);color:#fff}
@media(min-width:700px){.chip{font-size:14px;padding:5px 10px}#bStatus{font-size:13px}}
/* ---- bản đồ ---- */
#vp{flex:1;overflow:auto;position:relative}
#wrap{position:relative;margin:0 auto}
#world{position:absolute;left:0;top:0;width:960px;height:600px;transform-origin:0 0;overflow:hidden;border-radius:0 0 18px 18px;
 background:linear-gradient(#F3D3A4 0 28px,#8a6a4a 28px 31px,transparent 31px),repeating-conic-gradient(#FBE8C8 0 25%,#F6DDB6 0 50%) 0 0/48px 48px}
.ent{position:absolute;left:0;top:0}
[data-act]{cursor:pointer}
[data-act]:hover svg{filter:drop-shadow(0 0 3px #FFB84D) drop-shadow(0 0 2px #FFB84D)}
.kfloor{left:10px;top:31px;width:940px;height:150px;background:repeating-linear-gradient(90deg,#eef2ee 0 24px,#e3e9e4 24px 48px);border-radius:0 0 14px 14px;z-index:1}
.pcrug{left:312px;top:186px;width:576px;height:340px;background:rgba(91,157,239,.07);border:2px dashed rgba(91,157,239,.35);border-radius:22px;z-index:1}
.qlane{border:2px dashed rgba(48,48,48,.28);background:rgba(255,184,77,.12);border-radius:12px;z-index:1}
.lbl,.zone{position:absolute;left:50%;bottom:-10px;transform:translateX(-50%);background:#fff;border:2px solid var(--dark);border-radius:999px;font-size:11px;font-weight:900;padding:0 8px;white-space:nowrap;pointer-events:none}
.zone{transform:none;left:auto;bottom:auto;z-index:5}
.wallmenu{left:600px;top:7px;z-index:3;font-size:11px;font-weight:900;color:#5a3a22;white-space:nowrap}
/* máy */
.pc .desk,.pc .chair,.pc .tag{position:absolute;left:0}
.pc .chair{top:60px}
.pc .tag{top:108px;left:50%;transform:translateX(-50%);font-size:11px;background:#fff;border:2px solid var(--dark);border-radius:8px;padding:0 6px;text-align:center;white-space:nowrap;line-height:1.25;pointer-events:none}
.pc .scr{fill:#3d4454;transition:fill .3s} .pc .game{display:none}
.pc[data-s="OCCUPIED"] .scr{fill:#27406e} .pc[data-s="OCCUPIED"] .game{display:inline;animation:blink 1.2s infinite}
.pc[data-s="RESERVED"] .scr{fill:#F2B84B}
.pc[data-s="AVAILABLE"] .pst{color:#2f8a47} .pc[data-s="OCCUPIED"] .pst{color:#2f63b5} .pc[data-s="RESERVED"] .pst{color:#a86b00}
.pc.pick .desk{animation:pick .7s infinite alternate}
@keyframes pick{to{filter:drop-shadow(0 0 8px #5CC8A1) drop-shadow(0 0 3px #5CC8A1)}}
@keyframes blink{50%{opacity:.5}}
/* nhân vật */
.cust,.player{width:40px;height:56px}
.player{pointer-events:none}
.spr{width:40px;height:56px;transform-origin:50% 100%}
.walking .spr{animation:bob .25s infinite alternate}
@keyframes bob{to{translate:0 -2px}}
.bub{position:absolute;bottom:60px;left:50%;transform:translateX(-50%);background:#fff;border:2px solid var(--dark);border-radius:12px;padding:3px 8px;font-size:12px;white-space:nowrap;line-height:1.3;display:none;text-align:center;font-weight:800}
.bub.on{display:block} .bub.order.on{display:flex;gap:3px;align-items:center;padding:3px 5px;border-color:var(--sec);border-width:2.5px}
.bub.money{background:#FFF3C4}
.bub:after{content:'';position:absolute;bottom:-8px;left:50%;margin-left:-6px;border:6px solid transparent;border-top-color:var(--dark);border-bottom:0}
.bub .oi{position:relative;line-height:0}
.bub .oi.rd:after{content:'✓';position:absolute;right:-4px;top:-6px;background:var(--ok);color:#fff;border-radius:50%;font-size:10px;line-height:14px;width:14px;text-align:center}
.bub .oi.wip{opacity:.75}
.bub .md{font-size:14px;line-height:1}
.pat{position:absolute;bottom:-9px;left:4px;width:32px;height:6px;background:#eee;border:1.5px solid var(--dark);border-radius:4px;overflow:hidden;display:none}
.pat i{display:block;height:100%}
.qn{position:absolute;top:-2px;left:-10px;background:#fff;border:2px solid var(--dark);border-radius:999px;font-size:11px;font-weight:900;padding:0 5px;display:none}
.cust .ring{display:none;position:absolute;left:-7px;bottom:-9px;width:54px;height:18px;border:3px solid var(--ok);border-radius:50%}
.cust .arr{display:none;position:absolute;left:50%;transform:translateX(-50%);bottom:72px;font-size:20px;color:var(--ok);text-shadow:0 0 3px #fff}
.cust.nvc .ring{display:block;animation:ringp .6s infinite alternate}
.cust.nvc .arr{display:block;animation:arrb .45s infinite alternate}
@keyframes ringp{to{transform:scale(1.15)}}
@keyframes arrb{to{bottom:80px}}
.ptag{position:absolute;bottom:-12px;left:50%;transform:translateX(-50%);font-size:11px;background:var(--pri);border:2px solid var(--dark);border-radius:999px;padding:0 6px;font-weight:900;white-space:nowrap}
.staffch .ptag{background:var(--acc)}
.player .hand{position:absolute;left:50%;bottom:58px;transform:translateX(-50%);background:#fff;border:2px solid var(--dark);border-radius:10px;padding:1px;line-height:0;display:none}
.float{position:absolute;width:140px;margin-left:-70px;text-align:center;font-weight:900;font-size:17px;pointer-events:none;z-index:3000;animation:up 1.2s forwards;text-shadow:0 2px 0 #fff,0 -1px 0 #fff}
@keyframes up{to{transform:translateY(-44px);opacity:0}}
/* trạm bếp */
.ks{position:absolute;width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.ks.empty{border:2px dashed rgba(48,48,48,.28)}
.ks.sel{outline:3px solid var(--blue);outline-offset:1px}
.ks.warn{animation:kw .35s infinite alternate}
@keyframes kw{to{transform:scale(1.08)}}
.ks.shaking svg{animation:shk .18s infinite alternate}
@keyframes shk{from{transform:rotate(-9deg)}to{transform:rotate(9deg)}}
.ks .tb{position:absolute;left:-7px;right:-7px;bottom:-17px;height:13px;background:#cfcfcf;border:2px solid #303030;border-radius:6px;overflow:hidden}
.ks .tb i,.kpb i{position:absolute;top:0;bottom:0}
.zp{background:#58B368} .zo{background:#F2B84B} .zb{background:var(--blue)}
.ks .tb b,.kpb b{position:absolute;top:0;bottom:0;width:4px;background:#303030;margin-left:-2px}
.ks .bd{position:absolute;top:-8px;right:-8px;font-size:11px;background:#fff;border:1.5px solid #303030;border-radius:999px;padding:0 4px;line-height:1.4}
.ks .bd.ok{background:#DDF3E3}
.ks .pt{position:absolute;top:-9px;left:-8px;font-size:10px;font-weight:900;background:var(--dark);color:#fff;border-radius:999px;padding:0 4px;line-height:1.5;white-space:nowrap}
.ks .need{position:absolute;bottom:-30px;left:50%;transform:translateX(-50%);font-size:10px;font-weight:900;background:#E6F1FB;border:1.5px solid var(--blue);border-radius:999px;padding:0 4px;white-space:nowrap;z-index:2}
.kbn{position:absolute;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.75);border:1.5px solid #303030;border-radius:7px;cursor:pointer}
.kbn.out{opacity:.35}
.nv{outline:3px dashed #E8A21B;outline-offset:4px;border-radius:12px;animation:nvp .7s infinite alternate}
@keyframes nvp{to{outline-offset:9px}}
.nvb{border-color:var(--blue)!important;background:#E6F1FB!important;animation:nvb .5s infinite alternate}
@keyframes nvb{to{transform:scale(1.12)}}
.teach .nv{outline:5px solid #E85D5D;animation-duration:.4s}
.teach .kbn.nvb{transform:scale(1.2)}
.autob{position:absolute;top:-9px;left:6px;background:var(--acc);color:#fff;font-size:11px;font-weight:900;border:2px solid var(--dark);border-radius:999px;padding:0 6px;pointer-events:none}
.lockst{filter:grayscale(1) opacity(.5);pointer-events:none}
.lockb{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);background:#303030;color:#fff;font-size:11px;font-weight:900;border-radius:999px;padding:1px 8px;white-space:nowrap;z-index:6;display:none}
.lockst .lockb{display:block}
.nopu [data-act="kst"][data-id="pickup"]{display:none}
.puslot{position:absolute;width:44px;height:44px;border-radius:10px;border:2px dashed rgba(48,48,48,.25);display:flex;align-items:center;justify-content:center;cursor:pointer;background:rgba(255,255,255,.5)}
.puslot.full{border:2px solid var(--dark);background:#fff}
.puslot .pt{position:absolute;bottom:-8px;left:50%;transform:translateX(-50%);font-size:10px;font-weight:900;background:var(--ok);color:#fff;border-radius:999px;padding:0 5px;line-height:1.5;white-space:nowrap}
.puslot .pt.none{background:#999}
/* ---- thanh dưới + khay ---- */
#bar{display:flex;justify-content:space-around;padding:4px;background:#fff;border-top:2px solid var(--dark);padding-bottom:calc(4px + env(safe-area-inset-bottom))}
#bar button{border:none;display:flex;flex-direction:column;align-items:center;font-size:12px;min-width:0;flex:1;background:none;padding:2px}
#bar button span:first-child{font-size:20px}
#carry{position:fixed;left:10px;bottom:calc(68px + env(safe-area-inset-bottom));z-index:40;background:#fff;border:2px solid var(--dark);border-radius:14px;padding:4px 8px;display:flex;align-items:center;gap:6px;font-size:12px;font-weight:900;max-width:calc(100% - 20px);overflow-x:auto}
#carry.has{background:#FFF0D6}
#carry button{position:relative;min-height:44px;min-width:44px;padding:2px;border-radius:10px;flex:none}
#carry button.confirm{background:#FDE5E5;border-color:var(--bad)}
#carry .q{position:absolute;top:-7px;right:-7px;font-style:normal;font-size:11px;background:var(--warn);border-radius:999px;padding:0 4px;border:1px solid #303030}
#carry .to{position:absolute;bottom:-7px;left:50%;transform:translateX(-50%);font-style:normal;font-size:10px;background:var(--ok);color:#fff;border-radius:999px;padding:0 4px;white-space:nowrap}
#carry .sep{width:2px;align-self:stretch;background:var(--line);margin:0 2px;flex:none}
body.kb #carry{display:none}
/* ---- bàn thao tác ---- */
#kbar{position:fixed;left:0;right:0;bottom:calc(58px + env(safe-area-inset-bottom));z-index:42;background:#fff;border-top:2px solid var(--dark);display:none;flex-direction:column;gap:4px;padding:6px 8px}
.kneed{display:flex;flex-wrap:wrap;gap:4px;align-items:center;font-size:13px}
.kbs{display:flex;gap:10px;overflow-x:auto;padding:12px 4px 4px 10px}
.kbs button{position:relative;flex:none;min-width:68px;display:flex;flex-direction:column;align-items:center;font-size:12px;padding:3px 6px;border-radius:10px}
.kbs button small{font-size:11px;color:var(--muted)}
.kbs button.sel{background:#E6F1FB;border-color:var(--blue)}
.kbs button.out{opacity:.4}
.kbw{position:relative;flex:none;display:flex}
.kbw .mini{position:absolute;top:-8px;right:-8px;min-width:0;min-height:0;width:26px;height:26px;padding:0;border-radius:50%;font-size:11px;background:#FDE5E5}
.slotnum{display:inline-flex;width:30px;height:30px;align-items:center;justify-content:center;border:2px dashed #bbb;border-radius:8px;color:var(--muted)}
.kpb{position:relative;width:74px;height:11px;background:#cfcfcf;border:1.5px solid #303030;border-radius:5px;overflow:hidden;margin-top:3px}
.kbs .qty,.kbs .minus{position:absolute;top:-9px;min-width:30px;padding:0 7px;font-size:12px;font-weight:900;font-style:normal;line-height:1.2;text-align:center;border:2px solid var(--dark);border-radius:999px;color:#fff;z-index:3}
.kbs .qty{right:-6px;background:var(--blue)}
.kbs .minus{left:-6px;background:var(--bad);cursor:pointer}
.kbs .minus::before{content:'';position:absolute;inset:-10px}
.knext{display:flex;padding:4px 2px 2px}
.knext .tg{display:inline-block;max-width:100%;padding:4px 12px;font-size:13px;line-height:1.4;font-weight:900;background:#E5F6EC;border:2px solid var(--ok);color:#2f8a47;border-radius:999px}
.knext .tg b{color:#1f6b33}
.knext .tg.btn{cursor:pointer;padding:8px 14px;border-width:2.5px;background:#D4F0DC}
/* ---- bảng (sheet) ---- */
#sheetBg{position:fixed;inset:0;background:rgba(48,48,48,.35);display:none;z-index:50}
#sheet{position:fixed;left:50%;bottom:0;transform:translateX(-50%);width:min(560px,100%);max-height:78vh;overflow:auto;background:#fff;border:2px solid var(--dark);border-bottom:none;border-radius:22px 22px 0 0;padding:14px 16px calc(16px + env(safe-area-inset-bottom));z-index:51;display:none;animation:sh .2s}
@keyframes sh{from{transform:translate(-50%,30px);opacity:0}}
#sheet h2,#sheet h3{margin:0 0 8px;font-weight:900} #sheet h4{margin:14px 0 6px;font-weight:900}
.x{float:right;min-height:40px;width:40px;padding:0;border-radius:50%;margin-left:8px}
.row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 0;border-bottom:1px dashed var(--line)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:8px}
.grid button{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:6px;position:relative}
.grid small,.item small{font-size:11px;color:var(--muted);display:block}
.badge{font-size:11px;padding:1px 7px;border-radius:999px;border:1.5px solid var(--dark);white-space:nowrap}
.badge.warn{background:#FFE9B3} .badge.ok{background:#DDF3E3} .badge.acc{background:#D8F3EA} .badge.bad{background:#FDE5E5} .badge.wip{background:#E6F1FB}
.muted{color:var(--muted);font-size:13px}
.say{font-size:16px;font-weight:900;background:var(--bg);border-radius:12px;padding:8px 12px;margin:8px 0}
.eq{background:#E5F6EC;border-radius:10px;padding:6px 10px;margin:6px 0;font-size:14px}
.head{display:flex;align-items:center;gap:10px}
.item,.oitem{display:flex;align-items:center;gap:6px;padding:8px 0;border-bottom:1px dashed var(--line)}
.item button{display:flex;flex-direction:column;align-items:center}
.grow{flex:1;min-width:0}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(100px,1fr));gap:8px;margin:8px 0}
.stat{background:var(--bg);border-radius:12px;padding:8px 10px}
.stat small{display:block;color:var(--muted);font-size:12px} .stat b{font-size:18px}
.card{border:2px solid var(--dark);border-radius:14px;padding:8px 12px;margin:8px 0}
.ndcard{background:#FFF0D6;border-color:var(--pri)}
.ndcard ol{margin:4px 0 6px 20px;padding:0;font-size:14px;line-height:1.5}
.ndic{display:flex;gap:4px;margin:4px 0;flex-wrap:wrap}
.total{border-bottom:none;font-weight:900}
.profit .big{font-size:28px;font-weight:900} .profit.pos{background:#E5F6EC} .profit.neg{background:#FDE5E5}
.okc{color:#2f8a47} .badc{color:#c94141} .warnc{color:#a86b00}
.btns{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap} .btns button{flex:1} .btns.col{flex-direction:column}
.wide{width:100%;margin-top:12px}
.empty{text-align:center;padding:16px;color:var(--muted)}
.barrow{display:grid;grid-template-columns:1.2fr 2fr 34px;align-items:center;gap:8px;font-size:14px;padding:3px 0}
.bar{height:12px;background:var(--bg);border-radius:6px;overflow:hidden} .bar i{display:block;height:100%;background:var(--pri)}
.log{display:grid;grid-template-columns:44px 96px 1fr;gap:6px;font-size:13px;padding:4px 0;border-bottom:1px dashed var(--line)}
.pill{display:inline-flex;align-items:center;gap:3px;border:1.5px solid var(--dark);border-radius:999px;padding:1px 8px 1px 3px;font-size:12px;margin:2px}
.pill.done{text-decoration:line-through;color:var(--muted)}
.mrow{display:grid;grid-template-columns:24px 1fr 52px 96px;align-items:center;gap:6px;font-size:14px;padding:3px 0}
.trow{display:flex;gap:8px;padding:6px 0;border-bottom:1px dashed var(--line);font-size:14px} .trow small{display:block}
.prow{display:flex;align-items:center;gap:6px;padding:6px 0;border-bottom:1px dashed var(--line)}
.prow .pv{min-width:48px;text-align:center} .prow small{display:block}
.scard{border:2px solid var(--dark);border-radius:14px;padding:10px 12px;margin:8px 0;display:flex;gap:10px;align-items:flex-start}
.scard.on{background:#E5F6EC}
.center{text-align:center}
#toasts{position:fixed;top:60px;left:50%;transform:translateX(-50%);z-index:60;display:flex;flex-direction:column;gap:6px;align-items:center;pointer-events:none;width:max-content;max-width:92vw}
.toast{background:var(--dark);color:#fff;padding:8px 14px;border-radius:12px;font-size:14px;animation:sh .2s;text-align:center}
.toast.ok{background:#2f8a47} .toast.bad{background:#c94141}
</style>
</head>
<body>
<div id="app">
 <div id="top">
  <span class="chip" id="cDay"></span><span class="chip" id="cMoney"></span><span class="chip" id="cRate"></span>
  <button id="bStatus"></button>
  <button id="bPause" aria-label="Tạm dừng">⏸</button>
 </div>
 <div id="vp"><div id="wrap"><div id="world" role="application" aria-label="Bản đồ tiệm net"></div></div></div>
 <nav id="bar">
  <button data-nav="pcs"><span>🖥</span><span data-t="nav_pc"></span></button>
  <button data-nav="orders"><span>🍜</span><span data-t="nav_food"></span></button>
  <button data-nav="inv"><span>📦</span><span data-t="nav_inv"></span></button>
  <button data-nav="rev"><span>💰</span><span data-t="nav_rev"></span></button>
  <button data-nav="staff"><span>👥</span><span data-t="nav_staff"></span></button>
  <button data-nav="upg"><span>🔧</span><span data-t="nav_upg"></span></button>
  <button data-nav="set"><span>⚙️</span><span data-t="nav_set"></span></button>
 </nav>
</div>
<div id="carry"></div>
<div id="kbar"></div>
<div id="sheetBg"></div><div id="sheet" role="dialog" aria-modal="true"></div>
<div id="toasts" aria-live="polite"></div>
<script>
'use strict';
/* =====================================================================
 TIỆM NET v5 — bản sạch, 1 file. Đọc HANDOFF.md trước khi sửa.
 PHẦN: 1 Config+Data+Utils · 2 Text · 3 State+Save+Economy · 4 Customers+Day
       5 Kitchen+Matching+Delivery+Staff AI · 6 Art+World · 7 Render
       8 Input+Sheets+Loop · 9 Tests+init()
 QUY ƯỚC
 - Mỗi hàm chỉ có MỘT bản. Không ghi đè, không vá chồng.
 - Logic không đụng DOM. Hiệu ứng UI đi qua fx.* (tắt khi TEST=true). Lớp/ẩn-hiện DOM làm trong render.
 - Hàm logic trả {ok:true,step} | {ok:false,err,v}; err = key trong STR.
 - Tiền chỉ thay đổi qua addTx(amount,type,desc).
 STATE S (save v3 — giữ tương thích với v4)
  phase PREP|OPEN|CLOSING|REPORT · day · time(phút game) · money · rating · paused
